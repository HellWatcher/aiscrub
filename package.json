{
  "name": "aiscrub-detector",
  "version": "1.1.0",
  "description": "Deterministic detection engine and eval harness for the AIScrub skill. Detector vendored from conorbronsdon/avoid-ai-writing (MIT).",
  "license": "MIT",
  "main": "detector/patterns.js",
  "bin": {
    "aiscrub-detect": "detector/cli.js"
  },
  "files": [
    "detector/patterns.js",
    "detector/cli.js",
    "detector/engine/**/*.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node detector/test/run.js && node detector/categories.test.js",
    "detect": "node detector/cli.js",
    "eval": "node eval/run.js",
    "eval:echo": "node eval/echo.js",
    "research:metaphor": "node eval/metaphor-probe.js",
    "check-counts": "node scripts/check-counts.js",
    "check-line-cap": "node scripts/check-line-cap.js",
    "guards": "node scripts/check-counts.js && node scripts/check-line-cap.js",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4"
  }
}
